{
  "mcpServers": {
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-mcp-server@latest"],
      "env": {
        "FIREBASE_PROJECT_ID": "${EXPO_PUBLIC_FIREBASE_PROJECT_ID}"
      }
    },
    "firestore": {
      "command": "npx",
      "args": ["-y", "@anthropic/firestore-mcp@latest"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${FIREBASE_SERVICE_ACCOUNT_PATH}"
      }
    }
  }
}
