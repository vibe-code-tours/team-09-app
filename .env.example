# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (for Firebase Auth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cloudflare Worker (proxies AI API calls — keeps API keys server-side)
EXPO_PUBLIC_WORKER_URL=https://mhat-tan-worker.your-subdomain.workers.dev

# Proxy Secret — shared between app and Cloudflare Worker
# Generate with: openssl rand -hex 32
# Add the same value as PROXY_SECRET in your Cloudflare Worker env vars
EXPO_PUBLIC_PROXY_SECRET=

# AI Services (fallback — only used if WORKER_URL is not set)
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_VIBE_CODE_API_KEY=
EXPO_PUBLIC_VIBE_CODE_BASE_URL=https://proxy.vibecode.tours/v1
EXPO_PUBLIC_VIBE_CODE_MODEL=mimo-v2.5-pro
